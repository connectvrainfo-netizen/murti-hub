# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# SUPABASE DATABASE SETTINGS
# Obtain these from your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Project Anon Key (for public client reads)
SUPABASE_KEY=your-supabase-anon-key

# Project Service Role Secret Key (Required for Admin operations & bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION (FastAPI JWT)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@amolmurtibhandar.com
ADMIN_PASSWORD=admin123
JWT_SECRET=amol-murti-secret-key-jaipur-2026-bhandar
