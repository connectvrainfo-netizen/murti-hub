# ==============================================================================
# AMOL MARBLE MURTI BHANDAR - BACKEND CONFIGURATION
# ==============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# SUPABASE DATABASE SETTINGS
# Obtain these from your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Project Anon / Publishable Key (for public client reads)
SUPABASE_KEY=your-supabase-anon-key

# Project Service Role Secret Key (Server-only; NEVER commit or expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION (FastAPI JWT)
# Generate a cryptographically random secret (min 32 chars): python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=generate_a_strong_password_min_16_chars
JWT_SECRET=generate_a_cryptographically_random_256_bit_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# CORS ORIGINS (Comma-separated list of trusted frontend origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://murti-hub.vercel.app,https://yourdomain.com
