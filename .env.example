# ==============================================================================
# MURTI HUB - FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
# cp .env.example .env
#
# CRITICAL SECURITY RULE:
# NEVER place private server secrets (SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET,
# database credentials) in this file or any file bundled by Vite.
# Only variables prefixed with VITE_ are exposed to the client browser.
# ==============================================================================

# Public Supabase Project URL (obtained from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Publishable / Anon Key (Safe for client browsers)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Backend API Base URL (FastAPI Service on Render / Railway / Localhost)
VITE_API_URL=https://murti-hub-5.onrender.com

# Production Site URL (for SEO canonical links, OpenGraph, and Sitemaps)
VITE_SITE_URL=https://murti-hub-neon.vercel.app
